# 部署环境变量模板。复制为 .env 后填写真实值；.env 不要提交到 git。

# 数据库（连 1Panel 现有 PostgreSQL 容器，走 1panel-network 内部主机名）。
ASKWHY_DATABASE_URL=postgresql+psycopg://gpt_chong:你的密码@1Panel-postgresql-6MBx:5432/gpt_chong

# 敏感数据加密密钥（一旦确定不要再改，否则历史密文无法解密）。生成：python -c "import secrets;print(secrets.token_hex(32))"
ASKWHY_SECRET_KEY=请填写强随机值

# 管理后台口令（admin 登录）。生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
ASKWHY_ADMIN_TOKEN=请填写强随机口令

# 第三方 AskWhy 接口（一般无需改）。
ASKWHY_BASE_URL=https://askwhy123.shop
ASKWHY_API_PREFIX=/api
ASKWHY_REQUEST_PROXY=

# CORS：生产建议收紧到客户站与管理端实际域名，逗号分隔。
ASKWHY_CORS_ALLOW_ORIGINS=*

# 充值渠道上游（一般用默认即可；如上游域名变更在此覆盖）。
GIFT_BASE_URL=https://gpt.86gamestore.com
VIP_BASE_URL=https://data.zzlokp12.top
SOFT_BASE_URL=https://duolg.com

# 86 批量「账号行(含 rt)」换 token 参数（一般无需改）。
OPENAI_OAUTH_CLIENT_ID=app_2SKx67EdpoN0G6j64rFvigXD,app_LlGpXReQgckcGGUo2JrYvtJK
OPENAI_OAUTH_REDIRECT_URI=com.openai.chat://auth0.openai.com/ios/com.openai.chat/callback
OPENAI_IMPERSONATE=chrome

# 批量执行参数（默认即可；按上游承受度调整）。
GPT_BATCH_CONCURRENCY=1
GPT_BATCH_ITEM_INTERVAL=2
GPT_BATCH_RECHECK_ATTEMPTS=3
GPT_BATCH_RECHECK_INTERVAL=5
GPT_BATCH_STOCK_RETRY_INTERVAL=3
GPT_BATCH_FAILURE_PAUSE_THRESHOLD=0

# 对宿主暴露的端口（按需改，避免与现有服务冲突；可在 1Panel 反代后再隐藏）。
WEB_PORT=8080
ADMIN_PORT=8081
