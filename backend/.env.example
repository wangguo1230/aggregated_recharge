# AskWhy 充值服务配置模板。复制为 .env 后按实际环境修改；.env 不要提交到 git。

# 必填：PostgreSQL（运行时只支持 PG）。独立数据表 askwhy_orders，可与其它系统共用同一 PG 实例。
ASKWHY_DATABASE_URL=postgresql+psycopg://askwhy:askwhy_dev_password@127.0.0.1:5432/askwhy

# 必填：敏感数据加密 / 指纹密钥。生产必须改成固定强随机值。
ASKWHY_SECRET_KEY=change-me-before-production
# 仅本地调试可设为 1 以兼容占位密钥；生产必须留空或 0。
ASKWHY_ALLOW_INSECURE_DEFAULTS=0

# 必填：管理页口令（录入/管理「外部码↔真实卡密」映射）。生产改成强随机值。
ASKWHY_ADMIN_TOKEN=change-me-admin-token

# 第三方 AskWhy 用户端 API 基地址，一般无需修改。
ASKWHY_BASE_URL=https://askwhy123.shop
ASKWHY_API_PREFIX=/api

# 出站访问 AskWhy 的 HTTP 代理；留空表示直连。
ASKWHY_REQUEST_PROXY=
ASKWHY_REQUEST_TIMEOUT=60
ASKWHY_REQUEST_RETRY=2

# 服务监听与 CORS（前端独立部署时把 origin 收紧到前端域名）。
ASKWHY_HOST=0.0.0.0
ASKWHY_PORT=18424
ASKWHY_CORS_ALLOW_ORIGINS=*

# ==================== 充值渠道上游 ====================
# 86GPT（Gift）上游：GPT 单笔充值 + 86GPT 批量提交走此通道。
GIFT_BASE_URL=https://gpt.86gamestore.com
GIFT_API_PREFIX=/api

# 74 渠道（zzlokp12）：74 单笔 + 74 批量。
VIP_BASE_URL=https://data.zzlokp12.top
VIP_API_PREFIX=/api

# 软件订阅渠道（ChatGPT 兑换 API）：软件订阅批量提交。
SOFT_BASE_URL=https://duolg.com
SOFT_API_PREFIX=/api

# ==================== 86 批量：账号行(含 refresh_token) → token ====================
# 账号行形如 邮箱----密码----xxx----rt.开头令牌；用 rt 调 auth0 换 access_token 再拼 session_info。
OPENAI_OAUTH_CLIENT_ID=app_2SKx67EdpoN0G6j64rFvigXD,app_LlGpXReQgckcGGUo2JrYvtJK
OPENAI_OAUTH_REDIRECT_URI=com.openai.chat://auth0.openai.com/ios/com.openai.chat/callback
# curl_cffi 浏览器指纹（绕过 Cloudflare 取账号信息），如 chrome/chrome110/safari 等。
OPENAI_IMPERSONATE=chrome

# ==================== 批量执行参数 ====================
# 批内默认并发数（建批时可单独指定，服务端 clamp 到 1~10）。
GPT_BATCH_CONCURRENCY=1
# 条目之间的间隔秒数。
GPT_BATCH_ITEM_INTERVAL=2
# 充值「处理中」到账复查：次数与间隔秒数（仅 86）。
GPT_BATCH_RECHECK_ATTEMPTS=3
GPT_BATCH_RECHECK_INTERVAL=5
# 库存/凭证不足等可重试错误的重刷间隔秒数（不封顶、按此间隔一直重试）。
GPT_BATCH_STOCK_RETRY_INTERVAL=3
# 累计失败达到该数则暂停整批（疑似系统性问题）；0=关闭（纯跳过继续）。
GPT_BATCH_FAILURE_PAUSE_THRESHOLD=0
